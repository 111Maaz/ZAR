# ZAR V2 Central Admin Dashboard — Environment Variables
# Copy this file to ".env" and fill in your Supabase project credentials.

# Supabase project URL (public, client-safe)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (public, client-safe — used for browser-side Supabase client)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: NEVER store the Supabase service-role key in Vite client environment variables.
# The service-role key must only be used server-side (edge functions, serverless APIs).
# It must NEVER be prefixed with VITE_ or exposed in browser-accessible code.
